PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
# Required in production. Set these as Railway secret variables.
APP_PASSWORD=
ENCRYPTION_KEY=
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3001
# Optional: object storage. If omitted, local persistent disk is used.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional when FFmpeg/FFprobe are on PATH or installed by Docker.
FFMPEG_PATH=
FFPROBE_PATH=
# Production frontend: set this as a GitHub Actions repository variable.
VITE_API_URL=
# Desktop launcher sets these automatically in its private local profile.
LOCAL_APP=0
QUEUE_ENABLED=1
